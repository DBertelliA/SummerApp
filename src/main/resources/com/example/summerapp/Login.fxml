<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.effect.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<AnchorPane id="anchorL" prefHeight="400.0" prefWidth="600.0" stylesheets="@../css/logInCss.css" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.summerapp.Controllers.LogInController">
   <children>
      <Label fx:id="confirmText" alignment="CENTER" contentDisplay="CENTER" layoutX="196.0" layoutY="223.0" prefHeight="18.0" prefWidth="210.0" textAlignment="CENTER" />
      <Button layoutX="273.0" layoutY="260.0" mnemonicParsing="false" onAction="#loginButton" prefHeight="26.0" prefWidth="56.0" style="-fx-background-color: #c6c6c6;" text="Log in" textFill="WHITE">
         <font>
            <Font size="11.0" />
         </font></Button>
      <TextField fx:id="user" layoutX="219.0" layoutY="135.0" promptText="User name" />
      <PasswordField fx:id="password" layoutX="219.0" layoutY="187.0" promptText="Password" />
      <Label layoutX="263.0" layoutY="58.0" lineSpacing="1.0" textFill="WHITE" underline="true">
         <font>
            <Font name="JetBrains Mono Regular" size="25.0" />
         </font></Label>
      <Button layoutX="270.0" layoutY="323.0" mnemonicParsing="false" onAction="#signInButton" prefHeight="26.0" prefWidth="60.0" style="-fx-background-color: #c6c6c6;" text="Create" textFill="WHITE">
         <font>
            <Font size="11.0" />
         </font></Button>
